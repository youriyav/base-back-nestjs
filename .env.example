#app
APP_PORT=3333
APP_DOMAIN=localhost
APP_URL=http://localhost:4200

# Environment: dev, production
# Affects helmet security headers (stricter in production)
NODE_ENV=dev

#cors
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

#database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_database_password
DB_NAME=your_database_name

#jwt
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_EXPIRES_IN=1h
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=7d

#brevo (email service)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=no-reply@example.com
BREVO_SENDER_NAME=YourAppName

#prospects (demo requests from the GestiRestoPro landing page)
# Recipient address for the "new demo request" internal notification email.
# If left empty, the notification is skipped (logged only) rather than failing the request.
PROSPECT_NOTIFICATION_EMAIL=

#redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

#MINIO
MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password
